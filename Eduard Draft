#### Question One (D.i.) - Ridge Regression

```{r qu_1d_03, include = TRUE, warning = FALSE, message = FALSE}

# Perform 10-fold cross-validation to find optimal lambda for Ridge (alpha = 0)
q1d_time_ridge <- system.time({
  q1d_cv_ridge <- cv.glmnet(
    x = q1d_x_train,
    y = q1d_y_train,
    alpha = 0,
    nfolds = 10
  )
})

```

Ridge regression cross-validation completed in `r round(q1d_time_ridge[3], 2)` seconds.


```{r qu_1d_04, include = TRUE, warning = FALSE, message = FALSE}

# Optimal lambda values
q1d_lambda_ridge_min <- q1d_cv_ridge$lambda.min
q1d_lambda_ridge_1se <- q1d_cv_ridge$lambda.1se

# Fit final ridge model with lambda.min
q1d_model_ridge <- glmnet(
  x = q1d_x_train,
  y = q1d_y_train,
  alpha = 0,
  lambda = q1d_lambda_ridge_min
)

# Number of predictors kept (Ridge keeps all, but coefficients may be near zero)
q1d_ridge_coef <- as.matrix(coef(q1d_model_ridge))
q1d_ridge_n <- ncol(q1d_x_train)  # Ridge retains all predictors by design

# Predict on test set
q1d_pred_ridge <- predict(q1d_model_ridge, newx = q1d_x_test, s = q1d_lambda_ridge_min)
q1d_mse_ridge <- mean((q1d_y_test - q1d_pred_ridge)^2)

```


