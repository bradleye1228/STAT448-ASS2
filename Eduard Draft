### Question One (A)

**(a) (8 marks) Explore the correlation between the variables using appropriate graphical tools (e.g. corrplot). Comment on any strong correlations or groups of correlated predictors.**


```{r qu_1a_01, include = TRUE, warning = FALSE, message = FALSE}

# Pearson correlation matrix
pearson_corr <- cor(q1_data, method = "pearson", use = "complete.obs")

# AOE ordering
aoe_order <- corrMatOrder(pearson_corr, order = "AOE")
corr_aoe <- pearson_corr[aoe_order, aoe_order]

# Keep only upper triangle
corr_upper <- corr_aoe
corr_upper[lower.tri(corr_upper, diag = TRUE)] <- NA

# Convert to long format
corr_long <- as.data.frame(corr_upper) %>%
  rownames_to_column("Var1") %>%
  pivot_longer(-Var1, names_to = "Var2", values_to = "Correlation") %>%
  filter(!is.na(Correlation))

# Variable names (ordered)
var_names <- rownames(corr_aoe)

```


```{r v1_qu_1a_02, include = TRUE, warning = FALSE, message = FALSE, fig.keep = "all", fig.width = 10, fig.height = 10, cache = FALSE, eval = TRUE}

# Plot the plotly correlation heatmap
