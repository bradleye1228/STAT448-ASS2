### Question Three (B)

**(b) Train an ElasticNet model to predict MEAN_ANNUAL_RAINFALL using 10-fold cross-validation to optimize values for α and λ.**


```{r qu_3b_01, include = TRUE, warning = FALSE, message = FALSE}

# Standardise using training set only (avoid data leakage)
q3_X_train_scaled <- scale(q3_X_train)

q3_X_test_scaled <- scale(
  q3_X_test,
  center = attr(q3_X_train_scaled, "scaled:center"),
  scale  = attr(q3_X_train_scaled, "scaled:scale")
)

```


```{r qu_3b_02, include = TRUE, warning = FALSE, message = FALSE}

# Establish alpha grid and lambda grids
q3_alpha_grid <- seq(0, 1, length.out = 10)
q3_lambda_grid <- 10^seq(3, -3, length.out = 100)

# ElasticNet cross validation for alpha and lambda tuning
q3_cv_list <- list()
q3_cv_error <- numeric(length(q3_alpha_grid))

q3_time_elnet <- system.time({
  for (i in seq_along(q3_alpha_grid)) {
    q3_cv_list[[i]] <- cv.glmnet(
      x = q3_X_train_scaled,
      y = q3_y_train,
      alpha = q3_alpha_grid[i],
      nfolds = 10,
      lambda = q3_lambda_grid
    )
    q3_cv_error[i] <- min(q3_cv_list[[i]]$cvm)
  }
  q3_best_idx <- which.min(q3_cv_error)
  q3_best_alpha <- q3_alpha_grid[q3_best_idx]
  q3_best_cv <- q3_cv_list[[q3_best_idx]]
})

```


```{r qu_3b_03, include = TRUE, warning = FALSE, message = FALSE}

# Find optimal lambda parameters
q3_lambda_min <- q3_best_cv$lambda.min
q3_lambda_1se <- q3_best_cv$lambda.1se

# Predictions
q3_pred_min <- predict(q3_best_cv, newx = q3_X_test_scaled, s = q3_lambda_min)
q3_pred_1se <- predict(q3_best_cv, newx = q3_X_test_scaled, s = q3_lambda_1se)

# Test MSE
q3_mse_min <- mean((q3_y_test - q3_pred_min)^2)
q3_mse_1se <- mean((q3_y_test - q3_pred_1se)^2)

# Model sparsity (non-zero coefficients)
q3_coef_min <- coef(q3_best_cv, s = q3_lambda_min)
q3_coef_1se <- coef(q3_best_cv, s = q3_lambda_1se)

q3_n_min <- sum(q3_coef_min[-1] != 0)
q3_n_1se <- sum(q3_coef_1se[-1] != 0)

```


```{r qu_3b_04, include = TRUE, warning = FALSE, message = FALSE}

